#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        launch_calc_search: launch_calc_search {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <60>;
            wait-ms = <100>;
            bindings =
                <&kp LG(R)>,
                <&macro_wait_time 150>,
                <&kp C &kp A &kp L &kp C>,
                <&macro_wait_time 500>,
                <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* 4 columns x 5 rows = 20 bindings per layer */

        default_layer {
            display-name = "BASE";
            bindings = <
       
&kp N7          &kp N8      &kp N9         &bt BT_CLR_ALL
&kp N4          &kp N5      &kp N6   	   &kp DEL
&kp N1          &kp N2      &kp N3         &kp BSPC
&kp N1          &kp N2      &kp N3         &kp KP_ENTER    
&kp KP_N0       &kp COMMA   &kp KP_DOT     &kp KP_ENTER
            >;
        };
    };
};